<?xml version="1.0"?>
<package format="2">
  <name>rm75_roh_gazebo_sim</name>
  <version>0.1.0</version>
  <description>Gazebo simulation of the RM75-BI arm with ROH-A001 hand grasping an apple, based on rm75_roh_description URDF.</description>
  <maintainer email="test@test.com">test</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_ros_control</depend>
  <depend>controller_manager</depend>
  <depend>xacro</depend>
  <depend>rm75_roh_description</depend>
  <depend>rm_description</depend>
  <depend>rohand_urdf_ros1</depend>
</package>
