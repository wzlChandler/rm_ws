<?xml version="1.0"?>
<package format="2">
  <name>rm75_roh_visual_grasping</name>
  <version>0.1.0</version>
  <description>Visual grasping for the RM75 arm with a ROH-A001 hand.</description>

  <maintainer email="test@example.com">test</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>moveit_commander</depend>
  <depend>moveit_msgs</depend>
  <depend>rm_msgs</depend>
  <depend>rospy</depend>
  <depend>rospkg</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>easy_handeye</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rm75_roh_moveit_config</exec_depend>
  <exec_depend>rohand_urdf_ros1</exec_depend>
  <exec_depend>visual_grasping</exec_depend>

  <test_depend>python3-nose</test_depend>
</package>
